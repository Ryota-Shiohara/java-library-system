{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile production sources",
            "type": "process",
            "command": "bash",
            "args": [
                "-lc",
                "bash ./scripts/compile.sh main"
            ],
            "windows": {
                "command": "C:\\Program Files\\Git\\bin\\bash.exe"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$javac",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Compile test sources",
            "type": "process",
            "command": "bash",
            "args": [
                "-lc",
                "bash ./scripts/compile.sh test"
            ],
            "windows": {
                "command": "C:\\Program Files\\Git\\bin\\bash.exe"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$javac",
            "dependsOn": "Compile production sources"
        },
        {
            "label": "Run all JUnit tests",
            "type": "process",
            "command": "bash",
            "args": [
                "-lc",
                "bash ./scripts/test.sh --no-build"
            ],
            "windows": {
                "command": "C:\\Program Files\\Git\\bin\\bash.exe"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "Compile test sources"
        }
    ]
}
